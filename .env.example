# Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control or include it in public archives.

# Server-side AI API keys (used only by /api/generate-quiz serverless function)
# IMPORTANT: Do NOT prefix AI keys with VITE_ — VITE_ variables are bundled into browser code!
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Configuration (Browser-safe public anon key + Row Level Security required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Comma-separated admin emails for UI route guarding (enforce RLS on backend!)
VITE_ADMIN_EMAILS=admin@comsats.edu.pk
