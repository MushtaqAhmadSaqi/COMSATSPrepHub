{
  "name": "comsatsprephub-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "node scripts/lint.cjs",
    "test": "node tests/app.test.mjs",
    "analyze": "node scripts/build.mjs --mode analyze",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./legacy/web/styles/tailwind-input.css -o ./legacy/web/styles/tailwind-built.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i ./legacy/web/styles/tailwind-input.css -o ./legacy/web/styles/tailwind-built.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "framer-motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
